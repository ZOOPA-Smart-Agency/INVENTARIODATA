{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Registro de equipos",
  "mainBinaryName": "inventario-registro",
  "identifier": "es.zoopa.inventario.registro",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Registro de equipos",
        "width": 560,
        "height": 740,
        "minWidth": 420,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Adds this computer to the inventory",
    "longDescription": "Reads this computer's hardware and software details and adds it to the company's IT inventory, or updates it if it is already there.",
    "publisher": "Zoopa",
    "copyright": "Zoopa",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "both", "languages": ["Spanish", "English", "Catalan"], "displayLanguageSelector": false }
    }
  }
}
